{
  "name": "@niur/nestjs-service-bus",
  "version": "1.2.0",
  "description": "NestJS Azure Service Bus Microservice Transport",
  "main": "dist/index",
  "types": "dist/index",
  "files": [
    "dist",
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "npm run build",
    "test": "npm run build && tsc -p test/types && node --test --test-timeout=10000 test/azure-service-bus.test.js",
    "test:integration": "npm run build && node --test --test-force-exit --test-timeout=60000 test/integration/azure-service-bus.integration.test.mjs",
    "check:pack": "npm run build && node scripts/check-pack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niurmiguel/nestjs-service-bus.git"
  },
  "author": "Niurmiguel Gonzalez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Niurmiguel/nestjs-service-bus/issues"
  },
  "homepage": "https://github.com/Niurmiguel/nestjs-service-bus#readme",
  "peerDependencies": {
    "@azure/service-bus": "^7.9.0",
    "@nestjs/common": "^10.0.4 || ^11.0.0",
    "@nestjs/core": "^10.0.4 || ^11.0.0",
    "@nestjs/microservices": "^10.0.4 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@azure/service-bus": "^7.10.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/microservices": "^12.3.2",
    "@types/node": "^22.20.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "azure",
    "cloud",
    "service bus",
    "AMQP",
    "nestjs",
    "microservice"
  ]
}
